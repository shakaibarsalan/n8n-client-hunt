# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Only the TOOLS read these. The n8n workflows read their secrets from n8n
# credentials and their tunables from the Config node, because $env is blocked
# below Enterprise on this instance and Variables are unlicensed.

# --- Database -------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI).
# Used by psql for the migrations and by tools/load_reference_data.py.
DATABASE_URL=postgres://user:change-me@host:5432/postgres

# --- n8n ------------------------------------------------------------------
# Settings -> n8n API. Used by tools/import-workflows.py.
#
# Rotate this if it has ever been pasted into a chat, a ticket or a shell
# history. It is a full-access key: it can read, write and activate every
# workflow on the instance, including the ones belonging to other projects.
N8N_URL=https://n8n.example.com
N8N_API_KEY=

# --- Self-hosted database and mail filer (deploy/docker-compose.yml) -------
# Read by docker compose from a .env next to docker-compose.yml.
POSTGRES_PASSWORD=change-me
IMAP_HOST=
IMAP_PORT=993
# OUTREACH_USER is the outreach mailbox, e.g. hello@<your-sending-domain>.
OUTREACH_USER=
OUTREACH_PASSWORD=

# --- Reference data -------------------------------------------------------
# Both datasets are re-released monthly. Pin a release so a re-run reproduces
# the same load rather than silently picking up new data mid-experiment.
OVERTURE_RELEASE=2026-08-19.0
# FSQ_PATH=s3://us-west-2.opendata.source.coop/fused/fsq-os-places/2025-01-10/places/*.parquet

# ==========================================================================
#  The keys below go in the n8n Config NODES, not here. Listed so that
#  "where do I put the Apify token" has one answer.
# ==========================================================================
#
#   Apify token      -> n8n credential "Apify token", type HTTP Header Auth
#                       name:  Authorization
#                       value: Bearer apify_api_xxxxxxxx
#
#                       Free plan: $5/month, no rollover, runs BLOCKED at $0.
#                       The cap lives in app_state.apify_spend, not here, so
#                       that the brake is queryable from inside the workflow.
#
#   Serper key       -> CH-02 Config node, serper_api_key
#                       Optional. Empty means Stage C is skipped and the
#                       classifier gives it no credit, so confidence caps
#                       lower. That is the intended degraded mode.
#
#   PageSpeed key    -> CH-02 Config node, pagespeed_api_key
#                       Optional. The API works without one; a key just
#                       raises the rate limit.
#
#   Telegram chat id -> the Config node of each workflow
